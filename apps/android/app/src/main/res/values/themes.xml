<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The house's launch colour and mark until Compose draws; then the plain theme below -->
    <style name="Theme.Erp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/house_launch</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Erp</item>
    </style>

    <style name="Theme.Erp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/house_ground</item>
        <item name="android:colorAccent">@color/house_accent</item>
    </style>
</resources>
