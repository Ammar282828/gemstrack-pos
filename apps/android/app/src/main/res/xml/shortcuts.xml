<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon, the launcher's search and the Assistant: "Talk to ERP" opens the open business listening (the iPhone's
     Siri phrase / Spotlight entry). The address is the app's own, erp://voice (AppRouter); the package is the flavor's (a resValue). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="erp://voice"
            android:targetPackage="@string/erp_package"
            android:targetClass="erp.app.MainActivity">
            <parameter android:name="feature" android:key="feature" />
        </intent>
    </capability>
    <shortcut
        android:shortcutId="talk_to_erp"
        android:enabled="true"
        android:icon="@drawable/ic_voice"
        android:shortcutShortLabel="@string/voice_shortcut_short"
        android:shortcutLongLabel="@string/voice_shortcut_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="erp://voice"
            android:targetPackage="@string/erp_package"
            android:targetClass="erp.app.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding android:key="feature" android:value="@array/voice_feature_names" />
        </capability-binding>
    </shortcut>
</shortcuts>
