<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Asked for after an owner signs in (the iPhone asks then too), never at launch -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Settings › Import contacts: asked for when the person presses "Read this phone's contacts", never at launch. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Phones without a camera or microphone can still run the ERP -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Package visibility (API 30+): without this SpeechRecognizer.isRecognitionAvailable answers false and the voice sheet never listens -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".ErpApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Erp.Splash"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links: the ERP's own address opens in the app, on its business (verified once the house's assetlinks.json names this app).
                 One app holds Taheri and House of Mina, so both addresses open here (a business added by its address opens through its own tap). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${erpHost}" />
                <data android:scheme="https" android:host="${erpHostOther}" />
            </intent-filter>
            <!-- A widget's tap: the app on that business and screen, never the browser (shoperp://open?b=<business>&p=<path>) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="shoperp" android:host="open" />
            </intent-filter>
            <!-- "Talk to ERP" from the system: a headset or car's voice command, and the assist gesture; both open the voice sheet
                 (AppRouter.voiceTarget). The launcher shortcut and the Quick Settings tile use erp://voice below. -->
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- The app's own address: erp://orders/ORD-000123 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="erp" />
            </intent-filter>
            <!-- Long-press the icon, the launcher's search and the Assistant: Talk to ERP (xml/shortcuts.xml) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Every page pushed from a tab or the create menu: its own Activity, so Android draws the open/close
             transition and the cross-activity predictive back itself (no custom animations anywhere). -->
        <activity
            android:name=".PageActivity"
            android:exported="false"
            android:theme="@style/Theme.Erp"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density" />

        <!-- Notifications: a refreshed token, and an alert that arrives while the app is open (lib/push/fcm.ts sends channelId = kind) -->
        <service
            android:name=".device.ErpMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="orders" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_erp" />

        <!-- Quick Settings tile "Talk to ERP": opens the app listening -->
        <service
            android:name=".device.VoiceTileService"
            android:exported="true"
            android:icon="@drawable/ic_voice"
            android:label="@string/voice_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The home-screen widget; its picker label is the flavor's app_name ("Taheri ERP" / "Mina ERP") -->
        <receiver
            android:name=".widget.ErpWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/erp_widget_info" />
        </receiver>

        <!-- Files a page shares (a PDF) and photos for file inputs, from the cache folders in xml/file_paths.xml only -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
