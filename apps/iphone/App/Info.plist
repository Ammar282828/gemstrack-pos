<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>shop.taheri.erp.open</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>shoperp</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>$(ERP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(ERP_DISPLAY_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ERPAccent</key>
	<string>$(ERP_ACCENT)</string>
	<key>ERPFirebaseAPIKey</key>
	<string>$(ERP_FIREBASE_API_KEY)</string>
	<key>ERPFirebaseAppID</key>
	<string>$(ERP_FIREBASE_APP_ID)</string>
	<key>ERPFirebaseProjectID</key>
	<string>$(ERP_FIREBASE_PROJECT_ID)</string>
	<key>ERPFirebaseSenderID</key>
	<string>$(ERP_FIREBASE_SENDER_ID)</string>
	<key>ERPFirebaseStorageBucket</key>
	<string>$(ERP_FIREBASE_STORAGE_BUCKET)</string>
	<key>ERPGoogleClientID</key>
	<string>$(ERP_GOOGLE_CLIENT_ID)</string>
	<key>ERPGround</key>
	<string>$(ERP_GROUND)</string>
	<key>ERPMetal</key>
	<string>$(ERP_METAL)</string>
	<key>ERPServerURL</key>
	<string>$(ERP_SERVER_URL)</string>
	<key>ERPSharedKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(ERP_BUNDLE_ID)</string>
	<key>ERPStoreName</key>
	<string>$(ERP_STORE_NAME)</string>
	<!-- Firebase must not swizzle the app delegate: in a SwiftUI app it swallowed the push token callback (2.2 sat on
	     "Registering this phone"). Sign-in is Google's, which needs none of it. -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>To photograph pieces, bills and slips for the ERP.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>To use Face ID instead of typing the delete code.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>To hear you when you speak to the ERP.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>To save invoices, stories and photos you share from the ERP.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>To add photos of pieces from your library.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>To show your words while you speak to the ERP.</string>
	<key>UIAppFonts</key>
	<array>
		<string>FuturaLT-Light.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>$(ERP_LAUNCH_COLOR)</string>
		<key>UIImageName</key>
		<string>$(ERP_LAUNCH_MARK)</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
