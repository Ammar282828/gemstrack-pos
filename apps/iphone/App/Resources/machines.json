{
  "version": 1,
  "derived": [
    {
      "name": "Invoice settlement",
      "field": "derived from invoices/<id>.status, balanceDue, amountPaid (never stored)",
      "states": [
        "due",
        "partly",
        "paid",
        "credit",
        "refunded"
      ],
      "labels": {
        "due": "Balance due",
        "partly": "Balance due",
        "paid": "Paid in full",
        "credit": "Credit to customer",
        "refunded": "Refunded"
      },
      "tones": {
        "due": "late",
        "partly": "owed",
        "paid": "settled",
        "credit": "credit",
        "refunded": "quiet"
      },
      "rule": "status Refunded: refunded. Else in whole rupees (under 1 settled): balance 1 or more: partly if anything was paid, else due; balance -1 or less: credit; otherwise paid."
    }
  ],
  "machines": [
    {
      "name": "Order",
      "field": "orders/<id>.status",
      "states": [
        "Pending",
        "In Progress",
        "Completed",
        "Cancelled",
        "Refunded"
      ],
      "final": [
        "Refunded"
      ],
      "labels": {
        "Pending": "Pending",
        "In Progress": "In Progress",
        "Completed": "Completed",
        "Cancelled": "Cancelled",
        "Refunded": "Refunded"
      },
      "tones": {
        "Pending": "owed",
        "In Progress": "working",
        "Completed": "settled",
        "Cancelled": "quiet",
        "Refunded": "quiet"
      },
      "moves": [
        {
          "from": [
            "Pending",
            "In Progress",
            "Completed",
            "Cancelled"
          ],
          "to": "Pending",
          "event": "set",
          "when": "not invoiced",
          "note": "reopen or send back"
        },
        {
          "from": [
            "Pending",
            "Completed",
            "Cancelled"
          ],
          "to": "In Progress",
          "event": "set",
          "when": "not invoiced"
        },
        {
          "from": [
            "Pending",
            "In Progress",
            "Cancelled"
          ],
          "to": "Completed",
          "event": "set",
          "when": "not invoiced",
          "note": "ticks every piece"
        },
        {
          "from": [
            "Pending",
            "In Progress",
            "Completed"
          ],
          "to": "Cancelled",
          "event": "set",
          "when": "not invoiced"
        },
        {
          "from": [
            "Pending"
          ],
          "to": "In Progress",
          "event": "pieces",
          "note": "every piece has a karigar"
        },
        {
          "from": [
            "Pending",
            "In Progress"
          ],
          "to": "Completed",
          "event": "pieces",
          "when": "not invoiced",
          "note": "the last piece ticked"
        },
        {
          "from": [
            "Completed"
          ],
          "to": "In Progress",
          "event": "pieces",
          "when": "not invoiced",
          "note": "a piece unticked"
        },
        {
          "from": [
            "Pending",
            "In Progress",
            "Completed"
          ],
          "to": "Completed",
          "event": "finalize",
          "note": "Finalize & invoice"
        },
        {
          "from": [
            "Completed"
          ],
          "to": "Pending",
          "event": "undoInvoice",
          "note": "the invoice deleted; back to its status before (or Pending)"
        },
        {
          "from": [
            "Completed"
          ],
          "to": "In Progress",
          "event": "undoInvoice"
        },
        {
          "from": [
            "Pending",
            "In Progress",
            "Completed"
          ],
          "to": "Refunded",
          "event": "refund",
          "note": "Refund: stock back, money out; the only way to Refunded"
        },
        {
          "from": [
            "Pending",
            "In Progress"
          ],
          "to": "Completed",
          "event": "delivered",
          "note": "the website or Shopify says the parcel arrived"
        },
        {
          "from": [
            "Pending",
            "In Progress",
            "Completed"
          ],
          "to": "Completed",
          "event": "shipped",
          "note": "Shopify shipped it"
        },
        {
          "from": [
            "Pending",
            "In Progress"
          ],
          "to": "Cancelled",
          "event": "lapse",
          "note": "a website order whose transfer never came"
        },
        {
          "from": [
            "Pending",
            "In Progress",
            "Completed"
          ],
          "to": "Cancelled",
          "event": "shopifyCancel",
          "when": "not invoiced",
          "note": "cancelled or returned on Shopify with nothing paid"
        }
      ]
    },
    {
      "name": "Repair",
      "field": "repairs/<id>.status",
      "states": [
        "received",
        "ready",
        "collected",
        "cancelled"
      ],
      "final": [],
      "labels": {
        "received": "In the shop",
        "ready": "Ready",
        "collected": "Collected",
        "cancelled": "Cancelled"
      },
      "tones": {
        "received": "working",
        "ready": "settled",
        "collected": "quiet",
        "cancelled": "quiet"
      },
      "moves": [
        {
          "from": [
            "ready",
            "cancelled",
            "collected"
          ],
          "to": "received",
          "event": "set",
          "note": "back in the shop (undo)"
        },
        {
          "from": [
            "received",
            "collected"
          ],
          "to": "ready",
          "event": "set"
        },
        {
          "from": [
            "received",
            "ready"
          ],
          "to": "collected",
          "event": "set",
          "when": "nothing owed (under 1 rupee is settled)"
        },
        {
          "from": [
            "received",
            "ready"
          ],
          "to": "cancelled",
          "event": "set"
        }
      ]
    },
    {
      "name": "Payment link",
      "field": "payment_links/<token>.state",
      "states": [
        "open",
        "paid",
        "expired",
        "attention"
      ],
      "final": [
        "paid"
      ],
      "labels": {
        "open": "Waiting for payment",
        "paid": "Paid",
        "expired": "Expired",
        "attention": "Paid, needs you"
      },
      "tones": {
        "open": "owed",
        "paid": "settled",
        "expired": "quiet",
        "attention": "late"
      },
      "moves": [
        {
          "from": [
            "open",
            "expired",
            "attention"
          ],
          "to": "paid",
          "event": "paid",
          "note": "Safepay says paid: recorded once, by Card"
        },
        {
          "from": [
            "open"
          ],
          "to": "expired",
          "event": "expire",
          "note": "30 days unpaid; still checked for a late payment"
        },
        {
          "from": [
            "open",
            "expired"
          ],
          "to": "attention",
          "event": "unapplied",
          "note": "paid, but its order or invoice is closed: the owner decides"
        }
      ]
    },
    {
      "name": "Website order",
      "field": "online_orders/<id>.state",
      "states": [
        "pending",
        "confirming",
        "confirmed",
        "declined"
      ],
      "final": [
        "confirmed",
        "declined"
      ],
      "labels": {
        "pending": "Waiting for the shop",
        "confirming": "Being confirmed",
        "confirmed": "Confirmed",
        "declined": "Declined"
      },
      "tones": {
        "pending": "owed",
        "confirming": "working",
        "confirmed": "settled",
        "declined": "quiet"
      },
      "moves": [
        {
          "from": [
            "pending"
          ],
          "to": "confirming",
          "event": "claim",
          "note": "a person pressed Confirm (held 2 minutes)"
        },
        {
          "from": [
            "confirming"
          ],
          "to": "confirming",
          "event": "claim",
          "note": "a claim older than 2 minutes is taken over"
        },
        {
          "from": [
            "confirming"
          ],
          "to": "confirmed",
          "event": "confirm",
          "note": "the ERP order is made"
        },
        {
          "from": [
            "confirming"
          ],
          "to": "pending",
          "event": "release",
          "note": "making the order failed"
        },
        {
          "from": [
            "pending"
          ],
          "to": "declined",
          "event": "decline"
        }
      ]
    },
    {
      "name": "TCS booking",
      "field": "orders/<id>.tcsBooking",
      "states": [
        "none",
        "pending",
        "booked",
        "cancelled"
      ],
      "final": [],
      "labels": {
        "none": "Not booked",
        "pending": "Booking…",
        "booked": "Booked",
        "cancelled": "Booking cancelled"
      },
      "tones": {
        "none": "quiet",
        "pending": "working",
        "booked": "settled",
        "cancelled": "quiet"
      },
      "moves": [
        {
          "from": [
            "none",
            "cancelled"
          ],
          "to": "pending",
          "event": "book",
          "when": "order not Cancelled or Refunded",
          "note": "held 90 seconds against a second booking"
        },
        {
          "from": [
            "pending"
          ],
          "to": "booked",
          "event": "booked",
          "note": "TCS gave the consignment number"
        },
        {
          "from": [
            "pending"
          ],
          "to": "none",
          "event": "failed"
        },
        {
          "from": [
            "booked"
          ],
          "to": "cancelled",
          "event": "cancel",
          "when": "the parcel has not left"
        }
      ]
    },
    {
      "name": "Pay batch",
      "field": "karigar_batches/<id>.closedDate",
      "states": [
        "open",
        "closed"
      ],
      "final": [
        "closed"
      ],
      "labels": {
        "open": "Open",
        "closed": "Settled"
      },
      "tones": {
        "open": "working",
        "closed": "quiet"
      },
      "moves": [
        {
          "from": [
            "open"
          ],
          "to": "closed",
          "event": "settle",
          "note": "Settle & Close / Carry Over: the total is worked out on the server from its payments, in the same transaction; one open batch per karigar (karigar_batch_locks/<karigarId>)"
        },
        {
          "from": [
            "open"
          ],
          "to": "open",
          "event": "file",
          "note": "a payment (expense) filed under it; refused once it is settled"
        }
      ]
    },
    {
      "name": "Post queue",
      "field": "social_queue/<id>.status",
      "states": [
        "draft",
        "held",
        "scheduled",
        "sending",
        "sent",
        "failed"
      ],
      "final": [
        "sent"
      ],
      "labels": {
        "draft": "Arriving",
        "held": "Held",
        "scheduled": "Scheduled",
        "sending": "Sending",
        "sent": "Sent",
        "failed": "Failed"
      },
      "tones": {
        "draft": "quiet",
        "held": "quiet",
        "scheduled": "owed",
        "sending": "working",
        "sent": "settled",
        "failed": "late"
      },
      "moves": [
        {
          "from": [
            "draft"
          ],
          "to": "held",
          "event": "ready",
          "note": "every image has arrived"
        },
        {
          "from": [
            "scheduled",
            "held"
          ],
          "to": "held",
          "event": "hold",
          "note": "keeps it until told"
        },
        {
          "from": [
            "failed"
          ],
          "to": "failed",
          "event": "hold",
          "note": "clears its time; it stays Failed"
        },
        {
          "from": [
            "sending"
          ],
          "to": "failed",
          "event": "hold",
          "when": "its claim has lapsed",
          "note": "something may have gone: it stays Failed so the list says what is left"
        },
        {
          "from": [
            "held",
            "scheduled",
            "failed"
          ],
          "to": "scheduled",
          "event": "schedule",
          "when": "approved if an AI made it",
          "note": "also how a failed piece gets its tries back"
        },
        {
          "from": [
            "sending"
          ],
          "to": "scheduled",
          "event": "schedule",
          "when": "its claim has lapsed; approved if an AI made it"
        },
        {
          "from": [
            "scheduled",
            "failed"
          ],
          "to": "sending",
          "event": "claim",
          "when": "its time has come, tries left, approved",
          "note": "the five-minute tick"
        },
        {
          "from": [
            "sending"
          ],
          "to": "sending",
          "event": "claim",
          "when": "its claim has lapsed, its time has come, tries left, approved",
          "note": "a takeover; recorded in takeovers, and no unit already done is sent again"
        },
        {
          "from": [
            "held",
            "scheduled",
            "failed"
          ],
          "to": "sending",
          "event": "claimNow",
          "when": "approved if an AI made it",
          "note": "Send now"
        },
        {
          "from": [
            "sending"
          ],
          "to": "sending",
          "event": "claimNow",
          "when": "its claim has lapsed; approved if an AI made it",
          "note": "a takeover, as above"
        },
        {
          "from": [
            "sending"
          ],
          "to": "sent",
          "event": "sent",
          "note": "every unit is done; only while still Sending under the sender’s own claim"
        },
        {
          "from": [
            "sending"
          ],
          "to": "failed",
          "event": "fail",
          "note": "some units did not go; only while still Sending under the sender’s own claim"
        }
      ]
    },
    {
      "name": "Order WhatsApp",
      "field": "shopify_whatsapp/<order id>.state",
      "states": [
        "awaiting-confirmation",
        "confirmed",
        "declined",
        "awaiting-payment",
        "slip-received",
        "paid",
        "sent",
        "failed",
        "no-whatsapp"
      ],
      "final": [
        "confirmed",
        "declined",
        "paid",
        "sent",
        "no-whatsapp"
      ],
      "labels": {
        "awaiting-confirmation": "Awaiting confirmation",
        "confirmed": "Confirmed on WhatsApp",
        "declined": "Cancel requested",
        "awaiting-payment": "Awaiting transfer",
        "slip-received": "Screenshot sent",
        "paid": "Paid · thanked on WhatsApp",
        "sent": "Thanked on WhatsApp",
        "failed": "WhatsApp did not send",
        "no-whatsapp": "No WhatsApp"
      },
      "tones": {
        "awaiting-confirmation": "working",
        "confirmed": "settled",
        "declined": "late",
        "awaiting-payment": "working",
        "slip-received": "owed",
        "paid": "settled",
        "sent": "quiet",
        "failed": "late",
        "no-whatsapp": "late"
      },
      "moves": [
        {
          "from": [
            "awaiting-confirmation",
            "failed"
          ],
          "to": "confirmed",
          "event": "confirm",
          "when": "cash on delivery",
          "note": "the customer answered 1 / Confirm; from Failed too (the message may have arrived)"
        },
        {
          "from": [
            "awaiting-confirmation",
            "failed"
          ],
          "to": "declined",
          "event": "decline",
          "when": "cash on delivery",
          "note": "the customer answered 2 / Cancel: the shop is asked to cancel it; the order itself is not cancelled"
        },
        {
          "from": [
            "awaiting-payment",
            "failed"
          ],
          "to": "slip-received",
          "event": "slip",
          "when": "bank transfer",
          "note": "a picture or PDF; from Failed too"
        },
        {
          "from": [
            "awaiting-payment",
            "slip-received"
          ],
          "to": "paid",
          "event": "paid",
          "note": "Shopify says the transfer is paid"
        },
        {
          "from": [
            "awaiting-confirmation",
            "awaiting-payment",
            "sent"
          ],
          "to": "failed",
          "event": "fail",
          "note": "the send threw; the shop is told. Not once the customer has answered"
        },
        {
          "from": [
            "awaiting-confirmation",
            "awaiting-payment",
            "sent"
          ],
          "to": "no-whatsapp",
          "event": "noWhatsapp",
          "note": "the number is not on WhatsApp; the shop is told"
        }
      ]
    }
  ]
}
