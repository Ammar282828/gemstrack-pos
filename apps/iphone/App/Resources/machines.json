{
  "version": 1,
  "machines": [
    {
      "name": "Order",
      "field": "orders/<id>.status",
      "states": [
        "Pending",
        "In Progress",
        "Completed",
        "Cancelled",
        "Refunded"
      ],
      "final": [
        "Refunded"
      ],
      "labels": {
        "Pending": "Pending",
        "In Progress": "In Progress",
        "Completed": "Completed",
        "Cancelled": "Cancelled",
        "Refunded": "Refunded"
      },
      "tones": {
        "Pending": "owed",
        "In Progress": "working",
        "Completed": "settled",
        "Cancelled": "quiet",
        "Refunded": "quiet"
      },
      "moves": [
        {
          "from": [
            "Pending",
            "In Progress",
            "Completed",
            "Cancelled"
          ],
          "to": "Pending",
          "event": "set",
          "when": "not invoiced",
          "note": "reopen or send back"
        },
        {
          "from": [
            "Pending",
            "Completed",
            "Cancelled"
          ],
          "to": "In Progress",
          "event": "set",
          "when": "not invoiced"
        },
        {
          "from": [
            "Pending",
            "In Progress",
            "Cancelled"
          ],
          "to": "Completed",
          "event": "set",
          "when": "not invoiced",
          "note": "ticks every piece"
        },
        {
          "from": [
            "Pending",
            "In Progress",
            "Completed"
          ],
          "to": "Cancelled",
          "event": "set",
          "when": "not invoiced"
        },
        {
          "from": [
            "Pending"
          ],
          "to": "In Progress",
          "event": "pieces",
          "note": "every piece has a karigar"
        },
        {
          "from": [
            "Pending",
            "In Progress"
          ],
          "to": "Completed",
          "event": "pieces",
          "when": "not invoiced",
          "note": "the last piece ticked"
        },
        {
          "from": [
            "Completed"
          ],
          "to": "In Progress",
          "event": "pieces",
          "when": "not invoiced",
          "note": "a piece unticked"
        },
        {
          "from": [
            "Pending",
            "In Progress",
            "Completed"
          ],
          "to": "Completed",
          "event": "finalize",
          "note": "Finalize & invoice"
        },
        {
          "from": [
            "Completed"
          ],
          "to": "Pending",
          "event": "undoInvoice",
          "note": "the invoice deleted; back to its status before (or Pending)"
        },
        {
          "from": [
            "Completed"
          ],
          "to": "In Progress",
          "event": "undoInvoice"
        },
        {
          "from": [
            "Pending",
            "In Progress",
            "Completed"
          ],
          "to": "Refunded",
          "event": "refund",
          "note": "Refund: stock back, money out; the only way to Refunded"
        },
        {
          "from": [
            "Pending",
            "In Progress"
          ],
          "to": "Completed",
          "event": "delivered",
          "note": "the website or Shopify says the parcel arrived"
        },
        {
          "from": [
            "Pending",
            "In Progress",
            "Completed"
          ],
          "to": "Completed",
          "event": "shipped",
          "note": "Shopify shipped it"
        },
        {
          "from": [
            "Pending",
            "In Progress"
          ],
          "to": "Cancelled",
          "event": "lapse",
          "note": "a website order whose transfer never came"
        },
        {
          "from": [
            "Pending",
            "In Progress",
            "Completed"
          ],
          "to": "Cancelled",
          "event": "shopifyCancel",
          "when": "not invoiced",
          "note": "cancelled or returned on Shopify with nothing paid"
        }
      ]
    },
    {
      "name": "Repair",
      "field": "repairs/<id>.status",
      "states": [
        "received",
        "ready",
        "collected",
        "cancelled"
      ],
      "final": [],
      "labels": {
        "received": "In the shop",
        "ready": "Ready",
        "collected": "Collected",
        "cancelled": "Cancelled"
      },
      "tones": {
        "received": "working",
        "ready": "owed",
        "collected": "settled",
        "cancelled": "quiet"
      },
      "moves": [
        {
          "from": [
            "ready",
            "cancelled",
            "collected"
          ],
          "to": "received",
          "event": "set",
          "note": "back in the shop (undo)"
        },
        {
          "from": [
            "received",
            "collected"
          ],
          "to": "ready",
          "event": "set"
        },
        {
          "from": [
            "received",
            "ready"
          ],
          "to": "collected",
          "event": "set",
          "when": "nothing owed (under 1 rupee is settled)"
        },
        {
          "from": [
            "received",
            "ready"
          ],
          "to": "cancelled",
          "event": "set"
        }
      ]
    },
    {
      "name": "Payment link",
      "field": "payment_links/<token>.state",
      "states": [
        "open",
        "paid",
        "expired",
        "attention"
      ],
      "final": [
        "paid"
      ],
      "labels": {
        "open": "Waiting for payment",
        "paid": "Paid",
        "expired": "Expired",
        "attention": "Paid, needs you"
      },
      "tones": {
        "open": "owed",
        "paid": "settled",
        "expired": "quiet",
        "attention": "late"
      },
      "moves": [
        {
          "from": [
            "open",
            "expired",
            "attention"
          ],
          "to": "paid",
          "event": "paid",
          "note": "Safepay says paid: recorded once, by Card"
        },
        {
          "from": [
            "open"
          ],
          "to": "expired",
          "event": "expire",
          "note": "30 days unpaid; still checked for a late payment"
        },
        {
          "from": [
            "open",
            "expired"
          ],
          "to": "attention",
          "event": "unapplied",
          "note": "paid, but its order or invoice is closed: the owner decides"
        }
      ]
    },
    {
      "name": "Website order",
      "field": "online_orders/<id>.state",
      "states": [
        "pending",
        "confirming",
        "confirmed",
        "declined"
      ],
      "final": [
        "confirmed",
        "declined"
      ],
      "labels": {
        "pending": "Waiting for the shop",
        "confirming": "Being confirmed",
        "confirmed": "Confirmed",
        "declined": "Declined"
      },
      "tones": {
        "pending": "owed",
        "confirming": "working",
        "confirmed": "settled",
        "declined": "quiet"
      },
      "moves": [
        {
          "from": [
            "pending"
          ],
          "to": "confirming",
          "event": "claim",
          "note": "a person pressed Confirm (held 2 minutes)"
        },
        {
          "from": [
            "confirming"
          ],
          "to": "confirming",
          "event": "claim",
          "note": "a claim older than 2 minutes is taken over"
        },
        {
          "from": [
            "confirming"
          ],
          "to": "confirmed",
          "event": "confirm",
          "note": "the ERP order is made"
        },
        {
          "from": [
            "confirming"
          ],
          "to": "pending",
          "event": "release",
          "note": "making the order failed"
        },
        {
          "from": [
            "pending"
          ],
          "to": "declined",
          "event": "decline"
        }
      ]
    },
    {
      "name": "TCS booking",
      "field": "orders/<id>.tcsBooking",
      "states": [
        "none",
        "pending",
        "booked",
        "cancelled"
      ],
      "final": [],
      "labels": {
        "none": "Not booked",
        "pending": "Booking…",
        "booked": "Booked",
        "cancelled": "Booking cancelled"
      },
      "tones": {
        "none": "quiet",
        "pending": "working",
        "booked": "settled",
        "cancelled": "quiet"
      },
      "moves": [
        {
          "from": [
            "none",
            "cancelled"
          ],
          "to": "pending",
          "event": "book",
          "when": "order not Cancelled or Refunded",
          "note": "held 90 seconds against a second booking"
        },
        {
          "from": [
            "pending"
          ],
          "to": "booked",
          "event": "booked",
          "note": "TCS gave the consignment number"
        },
        {
          "from": [
            "pending"
          ],
          "to": "none",
          "event": "failed"
        },
        {
          "from": [
            "booked"
          ],
          "to": "cancelled",
          "event": "cancel",
          "when": "the parcel has not left"
        }
      ]
    }
  ]
}
