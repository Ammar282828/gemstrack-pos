<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Debug build, which Xcode Cloud's "Mac check" runs its tests on (MAC-CHECKS.md): ERPMac.entitlements without
	     push and the keychain groups, the two that need a provisioning profile. Without one the test machine could not
	     launch the app at all ("Launchd job spawn failed", 2026-10-27). The tests run the demo: no sign-in, no push. -->
	<!-- TestFlight and the App Store take only sandboxed Mac apps. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The ERP, Firebase, Google sign-in, and Label LIVE on localhost:11180 (outgoing only; nothing listens). -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Photos and files the person picks or drops (piece photos, bills, CSVs) and the PDFs and tag files saved. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.assets.pictures.read-only</key>
	<true/>
	<!-- The Mac's camera or an iPhone's (Continuity Camera) for a piece's photo; the microphone for voice. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The label printer and invoices, printed from the app. -->
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
