<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight and the App Store take only sandboxed Mac apps. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The ERP, Firebase, Google sign-in, and Label LIVE on localhost:11180 (outgoing only; nothing listens). -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Photos and files the person picks or drops (piece photos, bills, CSVs) and the PDFs and tag files saved. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.assets.pictures.read-only</key>
	<true/>
	<!-- The Mac's camera or an iPhone's (Continuity Camera) for a piece's photo; the microphone for voice. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The label printer and invoices, printed from the app. -->
	<key>com.apple.security.print</key>
	<true/>
	<!-- Notifications through Apple's production service (a Mac app's key is com.apple.developer.aps-environment). -->
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
	<!-- As the iPhone's: the app's own keychain, then the one Firebase Auth and the widget read. Firebase Auth on a Mac
	     cannot keep its sign-in without a keychain access group. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(ERP_BUNDLE_ID).app</string>
		<string>$(AppIdentifierPrefix)$(ERP_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
