rules_version = '2';

// Firestore rules for TAHERI's project (gemstrack-pos) — not House of Mina's.
//
// Taheri's database was open to anyone from 2026-09-07 to 2026-09-30 (the owner's choice
// then; anyone with the public config could list every invoice). These are the rules that
// close it: only the four owners below, signed in with Google, read or write anything.
// Customers' invoice links go through /api/public/invoice/[id] with the link's key, and the
// website, the scheduler, the karigar and staff portals all go through the server, so none of
// them needs the database open.
//
// Publish in the Firebase console → gemstrack-pos → Firestore Database → Rules (paste, Publish).
// NOT with the Firebase CLI from this repo: .firebaserc's default is House of Mina's project,
// whose owners differ (it keeps its own rules).

service cloud.firestore {
  match /databases/{database}/documents {

    // Shop owners — full access to everything. The same four accounts as
    // NEXT_PUBLIC_STORE_OWNER_EMAILS in apphosting.taheri.yaml (the owner, 2026-09-30);
    // change both together. Google-verified addresses only.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'potatomasta501@gmail.com',
          'mmurtaza1970@gmail.com',
          'unknownuser80@gmail.com',
          'hmurtaza55@gmail.com'
        ];
    }

    // Shop-floor staff are in the same position as karigars below: they are not
    // on this list, so every client-side read and write is denied, and their
    // app reads through /api/staff/* instead. That is deliberate and it is the
    // real boundary — the app queries Firestore straight from the browser, so
    // anything the database will return is readable in devtools whatever the
    // UI chooses to draw. Hiding a page hides nothing; denying it here does.

    // Karigars sign in with Google too, but they get NO direct database access.
    // Their portal reads and writes exclusively through /api/karigar/*, which
    // runs server-side with the Admin SDK and hand-picks the fields they may
    // see. This matters because Firestore rules are per-document, not
    // per-field: allowing a karigar to read an `orders` doc so they could see
    // their own item would also expose the customer's name, phone number and
    // the full pricing of that order. Denying them here keeps that impossible
    // even if they bypass the UI and query Firestore directly.

    // Sign-in audit trail: any authenticated account may record its own
    // sign-in, but only owners can read the log back.
    match /signInLogs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isOwner();
    }

    // Per-caller counters behind the public website routes (/api/public/*).
    // Written by the Admin SDK only; nothing legitimate reads them from a browser.
    match /website_ratelimit/{key} {
      allow read, write: if false;
    }

    // Weights recorded at the counter for catalogue photographs, and anything
    // else the website routes keep. Written by the Admin SDK through
    // /api/website/*, which applies its own role check; a browser has no
    // reason to touch them directly.
    match /website_pieces/{key} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
