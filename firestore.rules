rules_version = '2';

// ██ TEMPORARY: THIS DATABASE IS OPEN TO ANYONE WHO KNOWS THE URL ██
//
// Opened deliberately on 2026-09-07 at Ammar's request, to use the live app
// without signing in. While this is deployed, anybody who finds
// studio--gemstrack-pos.us-central1.hosted.app -- or simply the project id,
// which ships in the browser bundle -- can read and write every customer name,
// phone number, address and the entire karigar ledger. No password, no account.
//
// TO PUT IT BACK: the previous rules are kept verbatim in firestore.rules.locked
// in this repo. Restore that file over this one and redeploy the ruleset.
//
// Nothing else in the app depends on this being open. The staff and karigar
// portals were already reading through /api/* with server-side checks, and those
// checks still stand -- this only removes the client-side boundary, which was
// the only thing protecting the book.

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
